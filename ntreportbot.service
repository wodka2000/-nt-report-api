[Unit]
Description=NT Report Bot — Telegram bot per report LinkedIn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntbot
WorkingDirectory=/opt/ntreportbot
EnvironmentFile=/etc/ntreportbot.env
ExecStart=/opt/ntreportbot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ntreportbot

# Limiti di sicurezza
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
